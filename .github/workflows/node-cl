name: Node.js & EJS CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [22.x, 24.x]

    steps:
      # 1. Check out your repository code
      - uses: actions/checkout@v4

      # 2. Set up Node.js and cache npm dependencies
      - name: Use Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node-version }}
          cache: 'npm'

      # 3. Install dependencies cleanly
      - name: Install dependencies
        run: npm ci

      # 4. Lint JS and EJS files (if configured in package.json)
      - name: Lint code and EJS templates
        run: npm run lint --if-present

      # 5. Build assets (e.g., Tailwind/SCSS if used alongside EJS)
      - name: Build frontend assets
        run: npm run build --if-present

      # 6. Run your test suite (Jest, Mocha, Supertest, etc.)
      - name: Run tests
        run: npm test
